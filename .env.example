# ---------------------------------------------------------------------------
# Trove configuration — copy to .env and adjust
# ---------------------------------------------------------------------------

# Password for the web interface. Empty means no sign-in at all — only sensible
# when it is bound to 127.0.0.1.
UI_PASSWORD=changeme

# Host folder where models and datasets land (mounted at /data).
# For an external disk: /Volumes/AI/models  or  /mnt/tank/models
DATA_DIR=./data

# Host folder for settings, token and queue state (mounted at /config).
CONFIG_DIR=./config

# Address and port the web interface listens on.
# 0.0.0.0 instead of 127.0.0.1 exposes it to your network — set a password first!
BIND_ADDR=127.0.0.1
PORT=7860

# Optional starting token. You can just as well set it under Settings in the
# interface, where it is stored in CONFIG_DIR/settings.json.
HF_TOKEN=

# Alternative Hub endpoint (a mirror or an enterprise Hub). Leave it commented
# out when unused — an empty value confuses huggingface_hub.
# HF_ENDPOINT=https://hf-mirror.com

# User/group id the container writes as. On Linux set these to `id -u` / `id -g`
# so the downloaded files belong to you.
PUID=1000
PGID=1000
